# Refugio do Cuscuzeiro - rotas, seguranca, cache e compressao

Options -Indexes
RewriteEngine On

# Pastas internas nunca sao servidas diretamente.
RewriteRule ^(?:app|config|database|docs|scripts|storage|tests|resources|tmp|output|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^\.env(?:\.|$) - [F,L,NC]

# Conteudo editorial e landing pages SEO, renderizados no servidor.
RewriteRule ^sitemap\.xml$ seo/sitemap.php [L]
RewriteRule ^robots\.txt$ seo/robots.php [L]
RewriteRule ^alugar-chacara/perto-de-sao-paulo/?$ /chacara-perto-de/sao-paulo/ [R=301,L,NE]
RewriteRule ^alugar-chacara/?$ seo/index.php?route=alugar-chacara [L,QSA]
RewriteRule ^alugar-chacara/(interior-de-sp|analandia|final-de-semana|para-familia|perto-de-sao-paulo)/?$ seo/index.php?route=alugar-chacara/$1 [L,QSA]
RewriteRule ^analandia/?$ seo/index.php?route=analandia [L,QSA]
RewriteRule ^chacara-perto-de/?$ seo/index.php?route=chacara-perto-de [L,QSA]
RewriteRule ^chacara-perto-de/([a-z0-9-]+)/?$ seo/index.php?route=chacara-perto-de/$1 [L,QSA]
RewriteRule ^blog/?$ seo/index.php?route=blog [L,QSA]
RewriteRule ^blog/([a-z0-9-]+)/?$ seo/index.php?route=blog/$1 [L,QSA]

# URLs permanentes para as secoes da landing page.
RewriteRule ^(a-chacara|avaliacoes-dos-hospedes|comodidades|galeria-de-fotos|videos-do-refugio|conheca-analandia|reserva-direta|localizacao)/?$ index.php?landing_section=$1 [L,QSA]

RewriteRule ^reserva/solicitar/?$ reserva/solicitar.php [L,QSA]
RewriteRule ^reserva/sucesso/?$ reserva/sucesso.php [L,QSA]
RewriteRule ^reserva/(?:pagamento/)?([A-Za-z0-9_-]{40,80})/?$ reserva/index.php?token=$1 [L,QSA]
RewriteRule ^api/reservas/solicitar/?$ api/reservas/solicitar.php [L,QSA]
RewriteRule ^api/reservas/([A-Za-z0-9_-]{40,80})/comprovante/?$ api/reservas/comprovante.php?token=$1 [L,QSA]
RewriteRule ^api/orcamentos/calcular/?$ api/orcamentos/calcular.php [L,QSA]
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^minha-reserva/([a-f0-9]{64})/pre-checkin/?$ minha-reserva/index.php?token=$1&action=precheckin-save [L,QSA]
RewriteRule ^minha-reserva/([a-f0-9]{64})/pre-checkin/?$ minha-reserva/index.php?token=$1&action=precheckin [L,QSA]
RewriteRule ^minha-reserva/([a-f0-9]{64})/contrato/enviar-assinado/?$ minha-reserva/index.php?token=$1&action=contract-upload [L,QSA]
RewriteRule ^minha-reserva/([a-f0-9]{64})/contrato/assinado\.pdf/?$ minha-reserva/index.php?token=$1&action=signed-contract-pdf [L,QSA]
RewriteRule ^minha-reserva/([a-f0-9]{64})/contrato\.pdf/?$ minha-reserva/index.php?token=$1&action=contract-pdf [L,QSA]
RewriteRule ^minha-reserva/([a-f0-9]{64})/?$ minha-reserva/index.php?token=$1 [L,QSA]
RewriteRule ^avaliar/obrigado/?$ avaliar/index.php?page=obrigado [L,QSA]
RewriteRule ^avaliar/([a-f0-9]{64})/?$ avaliar/index.php?token=$1 [L,QSA]
RewriteRule ^api/avaliacoes/publicas/?$ api/avaliacoes/publicas.php [L,QSA]
RewriteRule ^api/avaliacoes/([a-f0-9]{64})/?$ api/avaliacoes/index.php?token=$1 [L,QSA]
RewriteRule ^api/whatsapp/webhook/?$ api/whatsapp/webhook.php [L,QSA]
RewriteRule ^api/marketing/google-ads-script/?$ api/marketing/google-ads-script.php [L,QSA]
RewriteRule ^contato/whatsapp/?$ contato/whatsapp.php [L,QSA]

RewriteRule ^admin/?$ admin/index.php?route=dashboard [L,QSA]
RewriteRule ^admin/login/?$ admin/index.php?route=login [L,QSA]
RewriteRule ^admin/logout/?$ admin/index.php?route=logout [L,QSA]
RewriteRule ^admin/reservas/?$ admin/index.php?route=reservas [L,QSA]
RewriteRule ^admin/pedidos-whatsapp/?$ admin/index.php?route=pedidos-whatsapp [L,QSA]
RewriteRule ^admin/pedidos-whatsapp/criar/?$ admin/index.php?route=pedido-whatsapp-acao&action=criar [L,QSA]
RewriteRule ^admin/pedidos-whatsapp/documentos/([0-9]+)/?$ admin/index.php?route=pedido-whatsapp-documento&documento=$1 [L,QSA]
RewriteRule ^admin/pedidos-whatsapp/([0-9]+)/(gerar-proposta|enviar-proposta|aprovar-cobranca|gerar-cobranca|enviar-cobranca)/?$ admin/index.php?route=pedido-whatsapp-acao&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/pedidos-whatsapp/([0-9]+)/?$ admin/index.php?route=pedido-whatsapp-detalhe&id=$1 [L,QSA]
RewriteRule ^admin/clientes/?$ admin/index.php?route=clientes [L,QSA]
RewriteRule ^admin/clientes/([0-9]+)/exportar/?$ admin/index.php?route=cliente-exportar&id=$1 [L,QSA]
RewriteRule ^admin/clientes/([0-9]+)/(mesclar|anonimizar)/?$ admin/index.php?route=cliente-acao&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/clientes/([0-9]+)/?$ admin/index.php?route=cliente-detalhe&id=$1 [L,QSA]
RewriteRule ^admin/conversas/?$ admin/index.php?route=conversas [L,QSA]
RewriteRule ^admin/conversas/templates/sincronizar/?$ admin/index.php?route=conversa-templates [L,QSA]
RewriteRule ^admin/conversas/([0-9]+)/poll/?$ admin/index.php?route=conversa-poll&id=$1 [L,QSA]
RewriteRule ^admin/conversas/midia/([0-9]+)/?$ admin/index.php?route=conversa-midia&mensagem=$1 [L,QSA]
RewriteRule ^admin/conversas/([0-9]+)/(enviar|template|midia|atualizar|nota|criar-reserva|reenviar)/?$ admin/index.php?route=conversa-acao&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/marketing/?$ admin/index.php?route=marketing [L,QSA]
RewriteRule ^admin/marketing/conectar/(meta|google|tiktok)/?$ admin/index.php?route=marketing-conectar&provider=$1 [L,QSA]
RewriteRule ^admin/marketing/contas/?$ admin/index.php?route=marketing-contas [L,QSA]
RewriteRule ^admin/marketing/analisar/?$ admin/index.php?route=marketing-analisar [L,QSA]
RewriteRule ^admin/marketing/google-ads-script/download/?$ admin/index.php?route=marketing-google-script [L,QSA]
RewriteRule ^admin/marketing/integracoes/([0-9]+)/selecionar-conta/?$ admin/index.php?route=marketing-conta&id=$1 [L,QSA]
RewriteRule ^admin/marketing/integracoes/([0-9]+)/(sincronizar|testar|desconectar)/?$ admin/index.php?route=marketing-acao&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/configuracoes/integracoes/(meta|google|tiktok)/callback/?$ admin/index.php?route=marketing-callback&provider=$1 [L,QSA]
RewriteRule ^admin/financeiro/?$ admin/index.php?route=financeiro [L,QSA]
RewriteRule ^admin/financeiro/exportar/?$ admin/index.php?route=financeiro-exportar [L,QSA]
RewriteRule ^admin/financeiro/(conta-criar|categoria-criar|fornecedor-criar|recebivel-criar|receber|recebivel-cancelar|recebimento-estornar|despesa-criar|despesa-pagar|despesa-cancelar|despesa-estornar|recorrencia-criar|recorrencias-gerar|conciliar|caucao-criar|caucao-atualizar)/?$ admin/index.php?route=financeiro-acao&action=$1 [L,QSA]
RewriteRule ^admin/configuracoes/integracoes/?$ admin/index.php?route=configuracoes [L,QSA]
RewriteRule ^admin/configuracoes/perfil/?$ admin/index.php?route=configuracao-perfil [L,QSA]
RewriteRule ^admin/reservas/([0-9]+)/(enviar-convite-avaliacao|reenviar-convite-avaliacao|revogar-convite-avaliacao)/?$ admin/index.php?route=review-invite&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/reservas/([0-9]+)/([a-z-]+)/?$ admin/index.php?route=acao&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/reservas/([0-9]+)/?$ admin/index.php?route=detalhe&id=$1 [L,QSA]
RewriteRule ^admin/avaliacoes/?$ admin/index.php?route=avaliacoes [L,QSA]
RewriteRule ^admin/avaliacoes/([0-9]+)/(aprovar|rejeitar|ocultar|republicar|responder)/?$ admin/index.php?route=review-action&id=$1&action=$2 [L,QSA]
RewriteRule ^admin/avaliacoes/([0-9]+)/?$ admin/index.php?route=avaliacao-detalhe&id=$1 [L,QSA]
RewriteRule ^admin/calendario/?$ admin/index.php?route=calendario [L,QSA]
RewriteRule ^admin/precos/?$ admin/index.php?route=precos [L,QSA]
RewriteRule ^admin/orcamentos/?$ admin/index.php?route=orcamentos [L,QSA]
RewriteRule ^admin/contratos/?$ admin/index.php?route=contratos [L,QSA]
RewriteRule ^admin/contratos/([0-9]+)/documentos/(hospede|final)\.pdf/?$ admin/index.php?route=contrato-assinado&id=$1&documento=$2 [L,QSA]
RewriteRule ^admin/contratos/([0-9]+)/pdf/?$ admin/index.php?route=contrato-pdf&id=$1 [L,QSA]
RewriteRule ^admin/pre-checkins/?$ admin/index.php?route=precheckins [L,QSA]
RewriteRule ^admin/automacoes/?$ admin/index.php?route=automacoes [L,QSA]
RewriteRule ^admin/configuracoes/propriedade/?$ admin/index.php?route=propriedade [L,QSA]
RewriteRule ^admin/operacoes/([a-z-]+)/?$ admin/index.php?route=operacao&action=$1 [L,QSA]
RewriteRule ^calendario/([a-f0-9]{64})\.ics$ calendario/index.php?token=$1 [L,QSA]
RewriteRule ^admin/comprovantes/([0-9]+)/?$ admin/index.php?route=comprovante&pagamento=$1 [L,QSA]
RewriteRule ^admin/bloqueios/?$ admin/index.php?route=bloqueio-criar [L,QSA]
RewriteRule ^admin/bloqueios/([0-9]+)/excluir/?$ admin/index.php?route=bloqueio-excluir&id=$1 [L,QSA]
RewriteRule ^politicas/(privacidade|termos|exclusao-de-dados|cancelamento|regras)/?$ politicas/index.php?tipo=$1 [L,QSA]

<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"

    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 7 days"

    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"

    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    Header unset ETag
    FileETag None

    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
        Header append Vary "Accept-Encoding"
    </FilesMatch>

    <FilesMatch "\.mp4$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    <FilesMatch "service-worker\.js$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    SetEnvIf Request_URI "^/(admin|api|reserva|minha-reserva|avaliar|contato)/" private_route
    Header set Cache-Control "private, no-store, max-age=0" env=private_route
    Header set X-Robots-Tag "noindex, nofollow" env=private_route
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>
